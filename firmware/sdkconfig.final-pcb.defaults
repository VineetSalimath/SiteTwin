# H1/H2 compile profile only. Dynamic hot-swap and GPIO19 output remain off.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ZB_ENABLED=y
CONFIG_SITETWIN_FINAL_PCB_PROFILE=y
CONFIG_SITETWIN_FINAL_PCB_HOTSWAP_WAKE_POLARITY_UNKNOWN=y
# CONFIG_SITETWIN_FINAL_PCB_SHARED_ALARM_OUTPUT_VERIFIED is not set
